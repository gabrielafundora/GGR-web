# Copia este archivo a .env (o .env.local) y completa los valores.

# URL de conexión a Postgres (Neon). Usa una rama de Neon distinta para
# desarrollo y para producción — ver README.md, sección "Base de datos".
# Esta es la conexión "pooled" (host con "-pooler"), la que usa la app.
DATABASE_URL="postgresql://usuario:password@ep-xxx-pooler.host/neondb?sslmode=require"

# Igual que DATABASE_URL pero SIN "-pooler" en el host (conexión directa).
# Solo la usan las migraciones de Prisma (migrate dev/deploy) — el pooler
# de Neon no soporta los advisory locks que necesitan.
DIRECT_URL="postgresql://usuario:password@ep-xxx.host/neondb?sslmode=require"

# Secreto usado por Auth.js para firmar la sesión del admin.
# Generar uno nuevo para producción con: openssl rand -base64 32
AUTH_SECRET="reemplaza-esto-con-un-valor-generado"

# URL pública del sitio (usada para resolver imágenes Open Graph absolutas).
# En producción, pon la URL real (ej. https://gabrielaguerrarey.com).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Almacenamiento de imágenes (Neon Object Storage, S3-compatible) — lo que
# usa el botón "Subir imagen" del admin. Ver README.md, sección "Imágenes".
AWS_ENDPOINT_URL_S3="https://<branch-id>.storage.c-2.us-east-2.aws.neon.tech"
AWS_REGION="us-east-2"
AWS_ACCESS_KEY_ID="nak_live_..."
AWS_SECRET_ACCESS_KEY="nsk_live_..."
NEON_STORAGE_BUCKET="ggr-uploads"
