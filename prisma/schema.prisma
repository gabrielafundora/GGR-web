// Prisma schema — Sitio web de Gabriela Guerra Rey
//
// Postgres (Neon) tanto en desarrollo como en producción — DATABASE_URL
// apunta a una rama de Neon distinta en cada entorno (ver .env.example y
// README.md, sección "Base de datos"), pero el esquema es el mismo.
//
// `directUrl` (conexión sin el pooler de Neon, sin "-pooler" en el host)
// es necesaria solo para `prisma migrate deploy/dev`: los bloqueos de
// sesión (advisory locks) que usan las migraciones no funcionan a través
// del pooler en modo transacción. El cliente de Prisma en runtime sigue
// usando `url` (pooled) para las queries normales de la app.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Book {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  subtitle      String?
  description   String
  coverImageUrl String
  amazonUrl     String
  year          Int?
  genre         String?
  published     Boolean  @default(true)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Article {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String
  contentMd     String
  coverImageUrl String?
  published     Boolean   @default(true)
  publishedAt   DateTime?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Course {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  imageUrl    String?
  externalUrl String
  modality    String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Metadatos (title/description/og:image) de las secciones principales del
/// sitio. `page` es una de: "home" | "catalogo" | "articulos" | "cursos" | "sobre-mi".
model PageMeta {
  id          String   @id @default(cuid())
  page        String   @unique
  title       String
  description String
  ogImageUrl  String?
  updatedAt   DateTime @updatedAt
}

/// Fila única (id fijo = 1) con la configuración general del sitio.
model SiteSettings {
  id              Int      @id @default(1)
  siteName        String
  tagline         String?
  heroHeadline    String?
  heroSubtext     String?
  heroImageUrl    String?
  authorBio       String?
  authorPhotoUrl  String?
  contactEmail    String?
  instagramUrl    String?
  facebookUrl     String?
  twitterUrl      String?
  goodreadsUrl    String?
  amazonAuthorUrl String?
  updatedAt       DateTime @updatedAt
}
